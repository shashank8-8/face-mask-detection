# ==============================================================================
# Git Ignore Configuration for Face Mask Detection Project
# ==============================================================================

# --- Datasets & Data Archives ---
dataset/
datasets/
data/*
processed_dataset/
*.zip
*.tar
*.tar.gz
*.rar
*.7z

# --- Trained Models, Weights & Checkpoints ---
model/
models/
checkpoints/
*.keras
*.h5
*.hdf5
*.tflite
*.onnx
*.pb
variables/
assets/

# --- Inference Output Images ---
output_*.jpg
output_*.png
result*.jpg
result*.png
reports/test_mask_result.jpg

# --- Python Environment & Bytecode ---
__pycache__/
*.py[cod]
*.pyc
*$py.class
*.so
.Python
.env
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# --- Virtual Environments ---
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# --- Jupyter Notebooks ---
.ipynb_checkpoints/
*/.ipynb_checkpoints/*

# --- IDEs & Editors ---
.vscode/
.idea/
*.swp
*.swo
*~
*.sublime-workspace
*.sublime-project

# --- Operating System Files ---
# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
desktop.ini
$RECYCLE.BIN/

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Linux
*~
.directory

# --- Logs, Temporary Files & Profiling ---
*.log
*.tmp
*.temp
logs/
tensorboard/
.pytest_cache/
